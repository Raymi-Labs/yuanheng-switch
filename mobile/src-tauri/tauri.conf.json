{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "元衡",
  "version": "0.1.0-alpha.1",
  "identifier": "com.nanashiwang.yuanhengmobile",
  "build": { "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "元衡", "width": 430, "height": 860, "minWidth": 320 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png"], "android": { "minSdkVersion": 29 }, "iOS": { "minimumSystemVersion": "15.0", "infoPlist": "Info.plist" } }
}
