{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuanHeng Desktop",
  "version": "0.1.117",
  "identifier": "com.nanashiwang.yuanhengswitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run prepare:core:dev && pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run prepare:core:release && pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; media-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yuanheng-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "yuanhengswitch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MTU0MEU0MTgzNTI5NzAKUldSd0tUVVk1RUFWeFd5NnZmMDV3VmhYOXdacjVnYVYxTkpVZ3pONk9RWU81RjhZMkFXNi8zQXkK",
      "endpoints": [
        "https://meta-api.vip/desktop/update/latest.json",
        "https://github.com/Raymi-Labs/yuanheng-switch/releases/latest/download/latest.json"
      ]
    }
  }
}
